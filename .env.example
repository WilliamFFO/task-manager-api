PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3001

# Database. Leave DATABASE_URL empty to use a local SQLite file.
# For the cloud, paste the connection string from Neon, Supabase, Render, etc.
DATABASE_URL=
DATABASE_PATH=tasks.sqlite
# Postgres TLS: leave empty for auto (on when the URL has sslmode=require), or "true" | "no-verify" | "false"
DATABASE_SSL=

# Requests per minute per IP (auth endpoints are limited to 10 per minute)
RATE_LIMIT=120
